name: Pull Supabase DB Schema

on:
  workflow_dispatch:  # allows manual trigger from GitHub UI

jobs:
  pull-schema:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repo
        uses: actions/checkout@v3

      - name: Install Supabase CLI
        run: |
          curl -sL https://github.com/supabase/cli/releases/latest/download/supabase-cli-linux-amd64 > supabase
          chmod +x supabase
          sudo mv supabase /usr/local/bin/supabase

      - name: Link Supabase Project
        run: supabase link --project-ref ${{ secrets.SUPABASE_PROJECT_ID }}
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}

      - name: Pull Schema from Supabase
        run: supabase db pull
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}

      - name: Commit Pulled Schema
        run: |
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add supabase/schema.sql
          git commit -m "chore: pull latest schema from Supabase" || echo "No changes to commit"
          git push
